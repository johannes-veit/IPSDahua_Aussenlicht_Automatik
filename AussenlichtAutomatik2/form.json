{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Dahua-Kamera / Personenerkennung",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "CameraHost",
          "caption": "Kamera IP / Host"
        },
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "Username",
          "caption": "Benutzername"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Passwort"
        },
        {
          "type": "Label",
          "caption": "Pro Dahua-Kamera eine eigene Instanz anlegen. Der Eventstream wird mit codes=[All] geöffnet; ausgewertet werden SmartMotionHuman sowie Human-Objekte in Dahua-IVS-Ereignissen. Die sichtbare Variable 'Person erkannt' steht immer zur Verfügung."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Optionale Lichtautomatik",
      "expanded": true,
      "items": [
        {
          "type": "CheckBox",
          "name": "LightAutomationEnabled",
          "caption": "Personenerkennung zusätzlich für Lichtautomatik verwenden"
        },
        {
          "type": "Label",
          "caption": "AUS = reine Personenerkennung. Dann werden Sonnenzeiten und Lichtvariablen vollständig ignoriert und es wird kein Lichtbefehl gesendet."
        },
        {
          "type": "SelectVariable",
          "name": "SunriseVariableID",
          "caption": "Location Control – Sonnenaufgang",
          "validVariableTypes": [1]
        },
        {
          "type": "SelectVariable",
          "name": "SunsetVariableID",
          "caption": "Location Control – Sonnenuntergang",
          "validVariableTypes": [1]
        },
        {
          "type": "SelectVariable",
          "name": "LightCommandVariableID",
          "caption": "Licht-Schaltvariable mit Aktion (z. B. LCNLight Status)",
          "validVariableTypes": [0],
          "requiredAction": 1
        },
        {
          "type": "SelectVariable",
          "name": "LightFeedbackVariableID",
          "caption": "Echte Licht-Rückmeldung",
          "validVariableTypes": [0]
        },
        {
          "type": "NumberSpinner",
          "name": "AfterRunSeconds",
          "caption": "Nachlauf nach Ende der Personenerkennung (Sekunden)",
          "minimum": 10,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Schaltbedingung bei aktivierter Lichtautomatik: Person erkannt UND nach Sonnenuntergang/vor Sonnenaufgang = Licht EIN. Helligkeits- oder Dunkelheitswerte werden nicht verwendet."
        },
        {
          "type": "Label",
          "caption": "Die Automatik schaltet nur Licht wieder AUS, das sie selbst eingeschaltet hat. Manuelle Bedienung bzw. GT8 hat Vorrang."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Diagnose",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "DebugEvents",
          "caption": "Alle Dahua-Ereignisse im Debug ausgeben"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Dahua-Verbindung neu anstoßen",
      "onClick": "ALA2_Reconnect($id);"
    },
    {
      "type": "Button",
      "caption": "Aktuellen Zustand ins Debug schreiben",
      "onClick": "ALA2_DumpState($id);"
    }
  ]
}
