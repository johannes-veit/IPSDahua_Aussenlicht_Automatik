{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Dahua-Kamera / Personenerkennung",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "CameraHost",
          "caption": "Kamera IP / Host"
        },
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "Username",
          "caption": "Benutzername"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Passwort"
        },
        {
          "type": "Label",
          "caption": "Pro Dahua-Kamera eine eigene Instanz anlegen. Der Eventstream läuft mit codes=[All]. Unterstützt werden direkte SmartMotionHuman-Ereignisse sowie mehrzeilige Human-IVS-Ereignisse (u. a. CrossLineDetection/CrossRegionDetection) für TiOC und IPC-HFW5442E-ZE/WizMind."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Optionale Lichtautomatik",
      "expanded": true,
      "items": [
        {
          "type": "CheckBox",
          "name": "LightAutomationEnabled",
          "caption": "Personenerkennung zusätzlich für Lichtautomatik verwenden"
        },
        {
          "type": "Label",
          "caption": "AUS = reine Personenerkennung. Dann werden Sonnenzeiten und Lichtvariablen vollständig ignoriert und es wird kein Lichtbefehl gesendet."
        },
        {
          "type": "SelectVariable",
          "name": "SunriseVariableID",
          "caption": "Location Control – Sonnenaufgang",
          "validVariableTypes": [
            1
          ]
        },
        {
          "type": "SelectVariable",
          "name": "SunsetVariableID",
          "caption": "Location Control – Sonnenuntergang",
          "validVariableTypes": [
            1
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LightCommandVariableID",
          "caption": "Licht schalten – Status (Boolean mit Aktion; auch nativer LCN-Ausgang)",
          "validVariableTypes": [
            0
          ],
          "requiredAction": 1
        },
        {
          "type": "SelectVariable",
          "name": "LightFeedbackVariableID",
          "caption": "Echte Rückmeldung – Intensität am Ausgang (Integer/Float; 0=AUS, >0=EIN)",
          "validVariableTypes": [
            1,
            2
          ],
          "requiredAction": 0
        },
        {
          "type": "Label",
          "caption": "Schalten: Boolean-Statusvariable mit Aktion auswählen. Rückmeldung: native Intensität/Intensity des realen Ausgangs auswählen; 0 = AUS, jeder Wert > 0 = EIN."
        },
        {
          "type": "NumberSpinner",
          "name": "AfterRunSeconds",
          "caption": "Nachlauf nach Ende der Personenerkennung (Sekunden)",
          "minimum": 10,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Schaltbedingung bei aktivierter Lichtautomatik: Person erkannt UND nach Sonnenuntergang/vor Sonnenaufgang = Licht EIN. Helligkeits- oder Dunkelheitswerte werden nicht verwendet."
        },
        {
          "type": "Label",
          "caption": "Die Automatik schaltet nur Licht wieder AUS, das sie selbst eingeschaltet hat. Manuelle Bedienung bzw. GT8 hat Vorrang."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Diagnose",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "DebugEvents",
          "caption": "Alle geparsten Dahua-Ereignisse inkl. Human-Klassifizierung im Debug ausgeben"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Dahua-Verbindung neu anstoßen",
      "onClick": "ALA2_Reconnect($id);"
    },
    {
      "type": "Button",
      "caption": "Aktuellen Zustand ins Debug schreiben",
      "onClick": "ALA2_DumpState($id);"
    }
  ]
}
